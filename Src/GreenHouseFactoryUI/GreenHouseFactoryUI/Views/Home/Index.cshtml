@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<div>
    Factory 1, Greenhouse 1: <span id="water-status-1-1">Unknown</span>
</div>
<div>
    Factory 1, Greenhouse 2: <span id="water-status-1-2">Unknown</span>
</div>

@section Scripts {
    <script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("http://localhost:5210/waterHub") // localhost:5210 -> container http://waterservice:8080/waterHub
        .withAutomaticReconnect()
        .build();

    connection.on("WaterStatusChanged", (data) => {
        console.log(data);
        const { factoryId, greenhouseId, isWaterOn } = data;
        const el = document.getElementById(`water-status-${factoryId}-${greenhouseId}`);
        if (el) {
            if (isWaterOn){
                el.textContent = "ON";
                el.style.color = "green";
            }
            else{
                el.textContent = "OFF";
                el.style.color = "red";
            }
        }
    });

    connection.start()
        .then(() => console.log("Connected to WaterHub"))
        .catch(err => console.error(err.toString()));
</script>
}
